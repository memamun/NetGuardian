        }
        lines {
          text: "    DisposableEffect(lifecycleOwner) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val observer = LifecycleEventObserver { _, event ->"
