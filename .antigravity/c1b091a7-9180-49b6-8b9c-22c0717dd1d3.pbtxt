        lines {
          text: "                // 1. Android Sandbox & NetGuardian VpnService Architecture"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                Text("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    text = \"1. Non-Root Sandbox vs. Network Layer Filtering\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    style = MaterialTheme.typography.labelMedium.copy(fontWeight = FontWeight.Bold),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    color = SleekPrimary"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                    color = MaterialTheme.colorScheme.primary"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                )"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                Text("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    text = \"Android\'s security architecture strictly prohibits third-party applications from forcibly killing, suspending, or freezing external processes without root permissions. NetGuardian solves this by operating at the Linux kernel networking layer using Android VpnService: rather than killing the app process, NetGuardian instantly drops or sinkholes all TCP/UDP socket connections from that application\'s UID as soon as background, screen-off, or device-idle conditions are satisfied.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    style = MaterialTheme.typography.bodySmall,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    color = SleekBodyText"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                    color = MaterialTheme.colorScheme.onSurface"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
