        }
        lines {
          text: "import android.content.Context"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "import androidx.datastore.preferences.core.Preferences"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
