        }
        lines {
          text: "            if (event == Lifecycle.Event.ON_RESUME) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                isVpnGranted = DiagnosticsHelper.isVpnAuthorized(context)"
