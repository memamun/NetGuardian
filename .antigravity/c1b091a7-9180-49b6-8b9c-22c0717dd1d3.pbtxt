    instruction: "Update AppItemCard and AppDetailSheetContent colors to use theme tokens"
    replacement_infos {
      original_chunk {
        target_content: "    Card(\n        modifier = modifier\n            .fillMaxWidth()\n            .clickable { onClick() }\n            .testTag(\"app_card_${app.packageName}\"),\n        shape = RoundedCornerShape(16.dp),\n        colors = CardDefaults.cardColors(\n            containerColor = MaterialTheme.colorScheme.surface\n        ),\n        border = androidx.compose.foundation.BorderStroke(\n            1.dp,\n            if (isBlocked) SleekBlockedRed.copy(alpha = 0.4f) else SleekBorder.copy(alpha = 0.8f)\n        )\n    ) {\n        Row(\n            modifier = Modifier\n                .fillMaxWidth()\n                .padding(14.dp),\n            verticalAlignment = Alignment.CenterVertically\n        ) {\n            // App Icon\n            Box(\n                modifier = Modifier\n                    .size(44.dp)\n                    .clip(RoundedCornerShape(12.dp))\n                    .background(SleekSurfaceVariant),\n                contentAlignment = Alignment.Center\n            ) {\n                if (app.iconBitmap != null) {\n                    Image(\n                        bitmap = app.iconBitmap.asImageBitmap(),\n                        contentDescription = \"${app.appName} Icon\",\n                        modifier = Modifier.size(34.dp)\n                    )\n                } else {\n                    Icon(\n                        imageVector = Icons.Default.Apps,\n                        contentDescription = null,\n                        tint = SleekPrimary,\n                        modifier = Modifier.size(24.dp)\n                    )\n                }\n            }\n\n            Spacer(modifier = Modifier.width(12.dp))\n\n            // App Names and Badges\n            Column(modifier = Modifier.weight(1f)) {\n                Text(\n                    text = app.appName,\n                    style = MaterialTheme.typography.titleMedium.copy(fontWeight = FontWeight.SemiBold),\n                    color = SleekBodyText,\n                    maxLines = 1\n                )\n\n                Text(\n                    text = app.packageName,\n                    style = MaterialTheme.typography.bodySmall,\n                    color = SleekMutedText,\n                    fontSize = 11.sp,\n                    maxLines = 1\n                )\n\n                Row(\n                    modifier = Modifier.padding(top = 4.dp),\n                    horizontalArrangement = Arrangement.spacedBy(6.dp)\n                ) {\n                    Surface(\n                        shape = RoundedCornerShape(4.dp),\n                        color = SleekSurfaceVariant\n                    ) {\n                        Text(\n                            text = \"UID ${app.uid}\",\n                            style = MaterialTheme.typography.labelSmall,\n                            color = SleekMutedText,\n                            fontSize = 10.sp,\n                            modifier = Modifier.padding(horizontal = 5.dp, vertical = 2.dp)\n                        )\n                    }\n                    if (app.isSystemApp) {\n                        Surface(\n                            shape = RoundedCornerShape(4.dp),\n                            color = SleekPrimaryContainer\n                        ) {\n                            Text(\n                                text = \"SYSTEM\",\n                                style = MaterialTheme.typography.labelSmall.copy(fontWeight = FontWeight.Bold),\n                                color = SleekOnPrimaryContainer,\n                                fontSize = 10.sp,\n                                modifier = Modifier.padding(horizontal = 5.dp, vertical = 2.dp)\n                            )\n                        }\n                    }\n                }\n            }\n\n            Spacer(modifier = Modifier.width(8.dp))\n\n            // Quick Toggle Controls (Wi-Fi, Mobile, Master Block)\n            Row(\n                horizontalArrangement = Arrangement.spacedBy(6.dp),\n                verticalAlignment = Alignment.CenterVertically\n            ) {\n                // Wi-Fi Button\n                IconButton(\n                    onClick = onToggleWifi,\n                    modifier = Modifier\n                        .size(36.dp)\n                        .background(\n                            if (isWifiBlocked) SleekBlockedContainer else SleekSurfaceVariant,\n                            CircleShape\n                        )\n                ) {\n                    Icon(\n                        imageVector = Icons.Default.Wifi,\n                        contentDescription = \"Toggle Wi-Fi\",\n                        tint = if (isWifiBlocked) SleekBlockedRed else SleekPrimary,\n                        modifier = Modifier.size(18.dp)\n                    )\n                }\n\n                // Mobile Data Button\n                IconButton(\n                    onClick = onToggleMobile,\n                    modifier = Modifier\n                        .size(36.dp)\n                        .background(\n                            if (isMobileBlocked) SleekBlockedContainer else SleekSurfaceVariant,\n                            CircleShape\n                        )\n                ) {\n                    Icon(\n                        imageVector = Icons.Default.SignalCellularAlt,\n                        contentDescription = \"Toggle Mobile Data\",\n                        tint = if (isMobileBlocked) SleekBlockedRed else SleekPrimary,\n                        modifier = Modifier.size(18.dp)\n                    )\n                }\n\n                // Master Block Toggle Button\n                IconButton(\n                    onClick = onToggleBlock,\n                    modifier = Modifier\n                        .size(36.dp)\n                        .background(\n                            if (isBlocked) SleekBlockedRed else SleekSurfaceVariant,\n                            CircleShape\n                        )\n                ) {\n                    Icon(\n                        imageVector = if (isBlocked) Icons.Default.Block else Icons.Default.Security,\n                        contentDescription = \"Toggle Total Block\",\n                        tint = if (isBlocked) Color.White else SleekMutedText,\n                        modifier = Modifier.size(18.dp)\n                    )\n                }\n            }\n        }\n    }\n}\n\n@Composable\nfun AppDetailSheetContent(\n    app: AppItem,\n    onUpdateRule: (AppRuleEntity) -> Unit,\n    onDismiss: () -> Unit,\n    modifier: Modifier = Modifier\n) {\n    val rule = app.rule\n\n    Column(\n        modifier = modifier\n            .fillMaxWidth()\n            .padding(horizontal = 24.dp, vertical = 16.dp)\n            .testTag(\"app_detail_sheet\"),\n        verticalArrangement = Arrangement.spacedBy(16.dp)\n    ) {\n        // App Header\n        Row(\n            modifier = Modifier.fillMaxWidth(),\n            verticalAlignment = Alignment.CenterVertically\n        ) {\n            Box(\n                modifier = Modifier\n                    .size(54.dp)\n                    .clip(RoundedCornerShape(14.dp))\n                    .background(SleekSurfaceVariant),\n                contentAlignment = Alignment.Center\n            ) {\n                if (app.iconBitmap != null) {\n                    Image(\n                        bitmap = app.iconBitmap.asImageBitmap(),\n                        contentDescription = \"${app.appName} Icon\",\n                        modifier = Modifier.size(44.dp)\n                    )\n                } else {\n                    Icon(\n                        imageVector = Icons.Default.Apps,\n                        contentDescription = null,\n                        tint = SleekPrimary,\n                        modifier = Modifier.size(28.dp)\n                    )\n                }\n            }\n\n            Spacer(modifier = Modifier.width(16.dp))\n\n            Column(modifier = Modifier.weight(1f)) {\n                Text(\n                    text = app.appName,\n                    style = MaterialTheme.typography.titleLarge.copy(fontWeight = FontWeight.Bold),\n                    color = SleekBodyText\n                )\n                Text(\n                    text = app.packageName,\n                    style = MaterialTheme.typography.bodySmall,\n                    color = SleekMutedText\n                )\n                Text(\n                    text = \"Linux UID: ${app.uid} \342\200\242 Version ${app.versionName}\",\n                    style = MaterialTheme.typography.labelSmall,\n                    color = SleekPrimary\n                )\n            }\n        }\n\n        // Presets Row\n        Text(\n            text = \"RULE PRESETS\",\n            style = MaterialTheme.typography.labelMedium.copy(\n                fontWeight = FontWeight.Bold,\n                letterSpacing = 0.8.sp\n            ),\n            color = SleekBodyText\n        )\n\n        Row(\n            modifier = Modifier.fillMaxWidth(),\n            horizontalArrangement = Arrangement.spacedBy(8.dp)\n        ) {\n            FilledTonalButton(\n                onClick = {\n                    onUpdateRule(rule.copy(isBlocked = false, blockWifi = false, blockMobile = false))\n                },\n                modifier = Modifier.weight(1f),\n                shape = RoundedCornerShape(12.dp),\n                colors = ButtonDefaults.filledTonalButtonColors(\n                    containerColor = SleekAllowedContainer,\n                    contentColor = SleekPrimary\n                )\n            ) {\n                Text(\"Allow All\", fontSize = 11.sp, fontWeight = FontWeight.Bold)\n            }\n            FilledTonalButton(\n                onClick = {\n                    onUpdateRule(rule.copy(isBlocked = true, blockWifi = false, blockMobile = false))\n                },\n                modifier = Modifier.weight(1f),\n                shape = RoundedCornerShape(12.dp),\n                colors = ButtonDefaults.filledTonalButtonColors(\n                    containerColor = SleekBlockedContainer,\n                    contentColor = SleekBlockedRed\n                )\n            ) {\n                Text(\"Block All\", fontSize = 11.sp, fontWeight = FontWeight.Bold)\n            }\n            FilledTonalButton(\n                onClick = {\n                    onUpdateRule(rule.copy(isBlocked = false, blockWifi = false, blockMobile = true))\n                },\n                modifier = Modifier.weight(1f),\n                shape = RoundedCornerShape(12.dp),\n                colors = ButtonDefaults.filledTonalButtonColors(\n                    containerColor = SleekSurfaceVariant,\n                    contentColor = SleekPrimaryText\n                )\n            ) {\n                Text(\"Wi-Fi Only\", fontSize = 11.sp, fontWeight = FontWeight.Bold)\n            }\n        }\n\n        // Granular Switches\n        Card(\n            modifier = Modifier.fillMaxWidth(),\n            shape = RoundedCornerShape(16.dp),\n            colors = CardDefaults.cardColors(\n                containerColor = MaterialTheme.colorScheme.surface\n            ),\n            border = androidx.compose.foundation.BorderStroke(1.dp, SleekBorder)\n        ) {"
        replacement_content: "    val netGuardian = MaterialTheme.netGuardian\n    Card(\n        modifier = modifier\n            .fillMaxWidth()\n            .clickable { onClick() }\n            .testTag(\"app_card_${app.packageName}\"),\n        shape = RoundedCornerShape(16.dp),\n        colors = CardDefaults.cardColors(\n            containerColor = MaterialTheme.colorScheme.surface\n        ),\n        border = androidx.compose.foundation.BorderStroke(\n            1.dp,\n            if (isBlocked) netGuardian.blocked.copy(alpha = 0.5f) else MaterialTheme.colorScheme.outlineVariant\n        )\n    ) {\n        Row(\n            modifier = Modifier\n                .fillMaxWidth()\n                .padding(14.dp),\n            verticalAlignment = Alignment.CenterVertically\n        ) {\n            // App Icon\n            Box(\n                modifier = Modifier\n                    .size(44.dp)\n                    .clip(RoundedCornerShape(12.dp))\n                    .background(MaterialTheme.colorScheme.surfaceVariant),\n                contentAlignment = Alignment.Center\n            ) {\n                if (app.iconBitmap != null) {\n                    Image(\n                        bitmap = app.iconBitmap.asImageBitmap(),\n                        contentDescription = \"${app.appName} Icon\",\n                        modifier = Modifier.size(34.dp)\n                    )\n                } else {\n                    Icon(\n                        imageVector = Icons.Default.Apps,\n                        contentDescription = null,\n                        tint = MaterialTheme.colorScheme.primary,\n                        modifier = Modifier.size(24.dp)\n                    )\n                }\n            }\n\n            Spacer(modifier = Modifier.width(12.dp))\n\n            // App Names and Badges\n            Column(modifier = Modifier.weight(1f)) {\n                Text(\n                    text = app.appName,\n                    style = MaterialTheme.typography.titleMedium.copy(fontWeight = FontWeight.SemiBold),\n                    color = MaterialTheme.colorScheme.onSurface,\n                    maxLines = 1\n                )\n\n                Text(\n                    text = app.packageName,\n                    style = MaterialTheme.typography.bodySmall,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant,\n                    fontSize = 11.sp,\n                    maxLines = 1\n                )\n\n                Row(\n                    modifier = Modifier.padding(top = 4.dp),\n                    horizontalArrangement = Arrangement.spacedBy(6.dp)\n                ) {\n                    Surface(\n                        shape = RoundedCornerShape(4.dp),\n                        color = MaterialTheme.colorScheme.surfaceVariant\n                    ) {\n                        Text(\n                            text = \"UID ${app.uid}\",\n                            style = MaterialTheme.typography.labelSmall,\n                            color = MaterialTheme.colorScheme.onSurfaceVariant,\n                            fontSize = 10.sp,\n                            modifier = Modifier.padding(horizontal = 5.dp, vertical = 2.dp)\n                        )\n                    }\n                    if (app.isSystemApp) {\n                        Surface(\n                            shape = RoundedCornerShape(4.dp),\n                            color = MaterialTheme.colorScheme.primaryContainer\n                        ) {\n                            Text(\n                                text = \"SYSTEM\",\n                                style = MaterialTheme.typography.labelSmall.copy(fontWeight = FontWeight.Bold),\n                                color = MaterialTheme.colorScheme.onPrimaryContainer,\n                                fontSize = 10.sp,\n                                modifier = Modifier.padding(horizontal = 5.dp, vertical = 2.dp)\n                            )\n                        }\n                    }\n                }\n            }\n\n            Spacer(modifier = Modifier.width(8.dp))\n\n            // Quick Toggle Controls (Wi-Fi, Mobile, Master Block)\n            Row(\n                horizontalArrangement = Arrangement.spacedBy(6.dp),\n                verticalAlignment = Alignment.CenterVertically\n            ) {\n                // Wi-Fi Button\n                IconButton(\n                    onClick = onToggleWifi,\n                    modifier = Modifier\n                        .size(36.dp)\n                        .background(\n                            if (isWifiBlocked) netGuardian.blockedContainer else MaterialTheme.colorScheme.surfaceVariant,\n                            CircleShape\n                        )\n                ) {\n                    Icon(\n                        imageVector = Icons.Default.Wifi,\n                        contentDescription = \"Toggle Wi-Fi\",\n                        tint = if (isWifiBlocked) netGuardian.blocked else MaterialTheme.colorScheme.primary,\n                        modifier = Modifier.size(18.dp)\n                    )\n                }\n\n                // Mobile Data Button\n                IconButton(\n                    onClick = onToggleMobile,\n                    modifier = Modifier\n                        .size(36.dp)\n                        .background(\n                            if (isMobileBlocked) netGuardian.blockedContainer else MaterialTheme.colorScheme.surfaceVariant,\n                            CircleShape\n                        )\n                ) {\n                    Icon(\n                        imageVector = Icons.Default.SignalCellularAlt,\n                        contentDescription = \"Toggle Mobile Data\",\n                        tint = if (isMobileBlocked) netGuardian.blocked else MaterialTheme.colorScheme.primary,\n                        modifier = Modifier.size(18.dp)\n                    )\n                }\n\n                // Master Block Toggle Button\n                IconButton(\n                    onClick = onToggleBlock,\n                    modifier = Modifier\n                        .size(36.dp)\n                        .background(\n                            if (isBlocked) netGuardian.blocked else MaterialTheme.colorScheme.surfaceVariant,\n                            CircleShape\n                        )\n                ) {\n                    Icon(\n                        imageVector = if (isBlocked) Icons.Default.Block else Icons.Default.Security,\n                        contentDescription = \"Toggle Total Block\",\n                        tint = if (isBlocked) netGuardian.onBlocked else MaterialTheme.colorScheme.onSurfaceVariant,\n                        modifier = Modifier.size(18.dp)\n                    )\n                }\n            }\n        }\n    }\n}\n\n@Composable\nfun AppDetailSheetContent(\n    app: AppItem,\n    onUpdateRule: (AppRuleEntity) -> Unit,\n    onDismiss: () -> Unit,\n    modifier: Modifier = Modifier\n) {\n    val rule = app.rule\n    val netGuardian = MaterialTheme.netGuardian\n\n    Column(\n        modifier = modifier\n            .fillMaxWidth()\n            .padding(horizontal = 24.dp, vertical = 16.dp)\n            .testTag(\"app_detail_sheet\"),\n        verticalArrangement = Arrangement.spacedBy(16.dp)\n    ) {\n        // App Header\n        Row(\n            modifier = Modifier.fillMaxWidth(),\n            verticalAlignment = Alignment.CenterVertically\n        ) {\n            Box(\n                modifier = Modifier\n                    .size(54.dp)\n                    .clip(RoundedCornerShape(14.dp))\n                    .background(MaterialTheme.colorScheme.surfaceVariant),\n                contentAlignment = Alignment.Center\n            ) {\n                if (app.iconBitmap != null) {\n                    Image(\n                        bitmap = app.iconBitmap.asImageBitmap(),\n           