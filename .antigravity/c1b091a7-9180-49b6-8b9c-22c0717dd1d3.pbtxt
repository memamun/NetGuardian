    instruction: "Update onDestroy receiver, buildNotification actions, and companion object in FirewallVpnService"
    replacement_infos {
      original_chunk {
        target_content: "    override fun onDestroy() {\n        isRunning = false\n        try {\n            unregisterReceiver(screenReceiver)\n        } catch (_: Exception) {}\n        workerThread?.interrupt()\n        try {\n            vpnInterface?.close()\n        } catch (_: Exception) {}\n        serviceScope.cancel()\n        super.onDestroy()\n    }\n\n    private fun createNotificationChannel() {\n        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {\n            val channel = NotificationChannel(\n                CHANNEL_ID,\n                \"NetGuardian Firewall Status\",\n                NotificationManager.IMPORTANCE_LOW\n            ).apply {\n                description = \"Shows active firewall filtering and quick controls\"\n                setShowBadge(false)\n            }\n            val manager = getSystemService(NotificationManager::class.java)\n            manager.createNotificationChannel(channel)\n        }\n    }\n\n    private fun buildNotification(statusText: String): Notification {\n        val openAppIntent = Intent(this, MainActivity::class.java).apply {\n            flags = Intent.FLAG_ACTIVITY_SINGLE_TOP\n        }\n        val openPendingIntent = PendingIntent.getActivity(\n            this,\n            0,\n            openAppIntent,\n            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT\n        )\n\n        val stopIntent = Intent(this, FirewallVpnService::class.java).apply {\n            action = ACTION_STOP\n        }\n        val stopPendingIntent = PendingIntent.getService(\n            this,\n            1,\n            stopIntent,\n            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT\n        )\n\n        return NotificationCompat.Builder(this, CHANNEL_ID)\n            .setContentTitle(\"NetGuardian Firewall\")\n            .setContentText(statusText)\n            .setSmallIcon(R.drawable.ic_shield)\n            .setContentIntent(openPendingIntent)\n            .setOngoing(true)\n            .setPriority(NotificationCompat.PRIORITY_LOW)\n            .addAction(R.drawable.ic_shield, \"Stop Firewall\", stopPendingIntent)\n            .build()\n    }\n\n    private fun updateNotification(statusText: String) {\n        val manager = getSystemService(NotificationManager::class.java)\n        manager?.notify(NOTIFICATION_ID, buildNotification(statusText))\n    }\n\n    companion object {\n        const val ACTION_START = \"com.example.netguardian.ACTION_START\"\n        const val ACTION_STOP = \"com.example.netguardian.ACTION_STOP\"\n        const val ACTION_RELOAD_RULES = \"com.example.netguardian.ACTION_RELOAD_RULES\"\n\n        private const val CHANNEL_ID = \"netguardian_firewall_channel\"\n        private const val NOTIFICATION_ID = 1001\n        private const val TAG = \"NetGuardianVPN\"\n    }"
        replacement_content: "    override fun onDestroy() {\n        isRunning = false\n        try {\n            unregisterReceiver(systemEventReceiver)\n        } catch (_: Exception) {}\n        workerThread?.interrupt()\n        try {\n            vpnInterface?.close()\n        } catch (_: Exception) {}\n        serviceScope.cancel()\n        super.onDestroy()\n    }\n\n    private fun createNotificationChannel() {\n        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {\n            val channel = NotificationChannel(\n                CHANNEL_ID,\n                \"NetGuardian Firewall Status\",\n                NotificationManager.IMPORTANCE_LOW\n            ).apply {\n                description = \"Shows active firewall filtering and quick controls\"\n                setShowBadge(false)\n            }\n            val manager = getSystemService(NotificationManager::class.java)\n            manager?.createNotificationChannel(channel)\n        }\n    }\n\n    private fun buildNotification(statusText: String): Notification {\n        val openAppIntent = Intent(this, MainActivity::class.java).apply {\n            flags = Intent.FLAG_ACTIVITY_SINGLE_TOP\n        }\n        val openPendingIntent = PendingIntent.getActivity(\n            this,\n            0,\n            openAppIntent,\n            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT\n        )\n\n        val stopIntent = Intent(this, FirewallVpnService::class.java).apply {\n            action = ACTION_STOP\n        }\n        val stopPendingIntent = PendingIntent.getService(\n            this,\n            1,\n            stopIntent,\n            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT\n        )\n\n        val blockNonSystemIntent = Intent(this, FirewallVpnService::class.java).apply {\n            action = ACTION_QUICK_BLOCK_NON_SYSTEM\n        }\n        val blockNonSystemPendingIntent = PendingIntent.getService(\n            this,\n            2,\n            blockNonSystemIntent,\n            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT\n        )\n\n        val wifiOnlyIntent = Intent(this, FirewallVpnService::class.java).apply {\n            action = ACTION_QUICK_WIFI_ONLY\n        }\n        val wifiOnlyPendingIntent = PendingIntent.getService(\n            this,\n            3,\n            wifiOnlyIntent,\n            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT\n        )\n\n        val allowAllIntent = Intent(this, FirewallVpnService::class.java).apply {\n            action = ACTION_QUICK_ALLOW_ALL\n        }\n        val allowAllPendingIntent = PendingIntent.getService(\n            this,\n            4,\n            allowAllIntent,\n            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT\n        )\n\n        val mode = firewallManager.activeQuickMode.value\n        val network = firewallManager.networkType.value\n\n        return NotificationCompat.Builder(this, CHANNEL_ID)\n            .setContentTitle(\"NetGuardian Firewall \342\200\224 Active\")\n            .setContentText(statusText)\n            .setSmallIcon(R.drawable.ic_shield)\n            .setContentIntent(openPendingIntent)\n            .setOngoing(true)\n            .setPriority(NotificationCompat.PRIORITY_LOW)\n            .setStyle(\n                NotificationCompat.BigTextStyle()\n                    .bigText(\"$statusText\\nActive Mode: ${mode.label} \342\200\242 Network: ${network.name}\\nQuick controls available below.\")\n            )\n            .addAction(R.drawable.ic_shield, \"Stop\", stopPendingIntent)\n            .addAction(R.drawable.ic_shield, if (mode == QuickMode.BLOCK_NON_SYSTEM) \"Normal Mode\" else \"Block Non-Sys\", if (mode == QuickMode.BLOCK_NON_SYSTEM) allowAllPendingIntent else blockNonSystemPendingIntent)\n            .addAction(R.drawable.ic_shield, if (mode == QuickMode.WIFI_ONLY) \"Normal Mode\" else \"Wi-Fi Only\", if (mode == QuickMode.WIFI_ONLY) allowAllPendingIntent else wifiOnlyPendingIntent)\n            .build()\n    }\n\n    private fun updateNotification(statusText: String) {\n        val manager = getSystemService(NotificationManager::class.java)\n        manager?.notify(NOTIFICATION_ID, buildNotification(statusText))\n    }\n\n    companion object {\n        const val ACTION_START = \"com.example.netguardian.ACTION_START\"\n        const val ACTION_STOP = \"com.example.netguardian.ACTION_STOP\"\n        const val ACTION_RELOAD_RULES = \"com.example.netguardian.ACTION_RELOAD_RULES\"\n        const val ACTION_QUICK_BLOCK_NON_SYSTEM = \"com.example.netguardian.ACTION_QUICK_BLOCK_NON_SYSTEM\"\n        const val ACTION_QUICK_ALLOW_ALL = \"com.example.netguardian.ACTION_QUICK_ALLOW_ALL\"\n        const val ACTION_QUICK_WIFI_ONLY = \"com.example.netguardian.ACTION_QUICK_WIFI_ONLY\"\n        const val ACTION_QUICK_MOBILE_ONLY = \"com.example.netguardian.ACTION_QUICK_MOBILE_ONLY\"\n\n        private const val CHANNEL_ID = \"netguardian_firewall_channel\"\n        private const val NOTIFICATION_ID = 1001\n        private const val TAG = \"NetGuardianVPN\"\n    }"
