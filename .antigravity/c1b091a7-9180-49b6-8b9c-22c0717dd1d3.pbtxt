          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            if (expanded) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                androidx.compose.material3.HorizontalDivider(color = SleekBorder.copy(alpha = 0.5f))"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                // 1. Android Sandbox & NetGuardian VpnService Architecture"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                Text("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    text = \"1. Non-Root Sandbox vs. Network Layer Filtering\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    style = MaterialTheme.typography.labelMedium.copy(fontWeight = FontWeight.Bold),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    color = SleekPrimary"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                )"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                Text("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    text = \"Android\'s security architecture strictly prohibits third-party applications from forcibly killing, suspending, or freezing external processes without root permissions. NetGuardian solves this by operating at the Linux kernel networking layer using Android VpnService: rather than killing the app process, NetGuardian instantly drops or sinkholes all TCP/UDP socket connections from that application\'s UID as soon as background, screen-off, or device-idle conditions are satisfied.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    style = MaterialTheme.typography.bodySmall,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    color = SleekBodyText"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                )"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                // 2. Android Version Boundaries"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                Text("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    text = \"2. Android OS Version Restrictions\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    style = MaterialTheme.typography.labelMedium.copy(fontWeight = FontWeight.Bold),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    color = SleekPrimary"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                )"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    Text("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        text = \"\342\200\242 Android 7.0\342\200\2238.0 (Nougat/Oreo): Introduced system Data Saver and Background Execution Limits. Apps without foreground services cannot hold long-lived background threads.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        style = MaterialTheme.typography.bodySmall,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        color = SleekBodyText"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    )"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    Text("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        text = \"\342\200\242 Android 9.0\342\200\22311 (Pie/Q/R): Introduced App Standby Buckets (Active, Working Set, Frequent, Rare). Network sync frequency is throttled by Android when an app moves to Rare or Restricted.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        style = MaterialTheme.typography.bodySmall,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        color = SleekBodyText"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    )"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    Text("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        text = \"\342\200\242 Android 12\342\200\22314+ (Snow Cone/Tiramisu/UpsideDownCake): Enforces the Phantom Process Killer (maximum 32 child processes system-wide) and strict foreground service type mandates (FOREGROUND_SERVICE_DATA_SYNC).\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        style = MaterialTheme.typography.bodySmall,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        color = SleekBodyText"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    )"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                // 3. Manufacturer OEM Aggressive Killers"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                Text("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    text = \"3. OEM Manufacturer Battery Killers\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    style = MaterialTheme.typography.labelMedium.copy(fontWeight = FontWeight.Bold),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
