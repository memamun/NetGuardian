d-xl flex items-center justify-center\'> <span class=\'text-lg\'>\360\237\223\267</span> </div> <div> <p class=\'text-sm font-bold\'>Instagram</p> <p class=\'text-[10px] text-[#44474E]\'>graph.facebook.com</p> </div> </div> <span class=\'text-[10px] font-bold text-[#0061A4] bg-[#D1E4FF] px-2 py-0.5 rounded\'>ALLOWED</span> </div> <div class=\'p-3 flex items-center justify-between opacity-50\'> <div class=\'flex items-center gap-3\'> <div class=\'w-10 h-10 bg-[#f0f0f0] rounded-xl flex items-center justify-center\'> <span class=\'text-lg\'>\360\237\220\246</span> </div> <div> <p class=\'text-sm font-bold\'>X (Twitter)</p> <p class=\'text-[10px] text-[#44474E]\'>ads-api.twitter.com</p> </div> </div> <span class=\'text-[10px] font-bold text-[#BA1A1A] bg-[#FFDAD6] px-2 py-0.5 rounded\'>BLOCKED</span> </div> </div> </section> </main> <nav class=\'bg-white border-t border-[#C2C7CF] flex justify-around items-center py-2 pb-6\'> <div class=\'flex flex-col items-center gap-1 text-[#001D36]\'> <div class=\'bg-[#D1E4FF] px-5 py-1 rounded-full\'> <svg class=\'w-6 h-6\' fill=\'currentColor\' viewBox=\'0 0 24 24\'><path d=\'M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z\'/></svg> </div> <span class=\'text-[10px] font-bold\'>Home</span> </div> <div class=\'flex flex-col items-center gap-1 text-[#44474E]\'> <svg class=\'w-6 h-6 opacity-70\' fill=\'currentColor\' viewBox=\'0 0 24 24\'><path d=\'M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-10v4h4V4h-4zm-6 4h4V4h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z\'/></svg> <span class=\'text-[10px] font-medium\'>Apps</span> </div> <div class=\'flex flex-col items-center gap-1 text-[#44474E]\'> <svg class=\'w-6 h-6 opacity-70\' fill=\'currentColor\' viewBox=\'0 0 24 24\'><path d=\'M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm6.93 6h-2.95c-.32-1.25-.78-2.45-1.38-3.56 1.84.63 3.37 1.91 4.33 3.56zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14C4.1 13.36 4 12.69 4 12s.1-1.36.26-2h3.38c-.08.66-.14 1.32-.14 2s.06 1.34.14 2H4.26zm.82 2h2.95c.32 1.25.78 2.45 1.38 3.56-1.84-.63-3.37-1.9-4.33-3.56zm2.95-8H5.08c.96-1.65 2.49-2.93 4.33-3.56-.6 1.11-1.06 2.31-1.38 3.56zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66c-.09-.66-.16-1.32-.16-2s.07-1.34.16-2h4.68c.09.66.16 1.32.16 2s-.07 1.34-.16 2zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95c-.96 1.65-2.49 2.93-4.33 3.56zM16.36 14c.08-.66.14-1.32.14-2s-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2h-3.38z\'/></svg> <span class=\'text-[10px] font-medium\'>Logs</span> </div> <div class=\'flex flex-col items-center gap-1 text-[#44474E]\'> <svg class=\'w-6 h-6 opacity-70\' fill=\'currentColor\' viewBox=\'0 0 24 24\'><path d=\'M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-1 6h2v2h-2V7zm0 4h2v6h-2v-6z\'/></svg> <span class=\'text-[10px] font-medium\'>Privacy</span> </div> </nav> </div>\\n  </body>\\n</html>\nDesign instructions: Extract ONLY the styling (colors, fonts, spacing, borders, shadows, backgrounds, gradients) and layout patterns (flexbox/grid structure, component arrangement) from the Design HTML above. Do NOT replace or restructure the existing app\'s HTML elements \342\200\224 preserve all existing components, content, and functionality. Only modify CSS/styling and adjust layout containers as needed to match the theme\'s aesthetic. You MUST execute file editing or creation tool calls (such as edit_file, multi_edit_file, or create_file) to apply styling updates to target files directly. Do NOT output code blocks, HTML, or TSX directly in your text chat response.\n[AIS_METADATA_SECTION_END]"
