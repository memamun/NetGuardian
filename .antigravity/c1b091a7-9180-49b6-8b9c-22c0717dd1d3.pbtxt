        }
        lines {
          text: "                        text = \"Local-First Architecture: NetGuardian intercepts UDP Port 53 queries right on your device. Blacklisted domains (ads, trackers, malware) are answered locally with a synthetic 0.0.0.0 sinkhole response. No queries are forwarded to mandatory external servers.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
