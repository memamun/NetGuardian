    instruction: "Update background activity section, cards, and switch rows in AppsScreen.kt to use theme tokens"
    replacement_infos {
      original_chunk {
        target_content: "        // 1. Search Bar\n        item {\n            OutlinedTextField(\n                value = searchQuery,\n                onValueChange = onSearchChange,\n                placeholder = { Text(\"Search apps for background rules...\", color = SleekMutedText) },\n                leadingIcon = { Icon(Icons.Default.Search, contentDescription = \"Search\", tint = SleekMutedText) },\n                trailingIcon = {\n                    if (searchQuery.isNotEmpty()) {\n                        IconButton(onClick = { onSearchChange(\"\") }) {\n                            Icon(Icons.Default.Clear, contentDescription = \"Clear\", tint = SleekMutedText)\n                        }\n                    }\n                },\n                singleLine = true,\n                shape = RoundedCornerShape(16.dp),\n                colors = OutlinedTextFieldDefaults.colors(\n                    focusedBorderColor = SleekPrimary,\n                    unfocusedBorderColor = SleekBorder,\n                    focusedContainerColor = MaterialTheme.colorScheme.surface,\n                    unfocusedContainerColor = MaterialTheme.colorScheme.surface\n                ),\n                modifier = Modifier.fillMaxWidth()\n            )\n        }\n\n        // 2. Android & OEM Limitations Deep Dive Card\n        item {\n            AndroidLimitationsExplanationCard()\n        }\n\n        // 3. Global Quick Actions for Background Policies\n        item {\n            Card(\n                modifier = Modifier.fillMaxWidth(),\n                shape = RoundedCornerShape(16.dp),\n                colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),\n                border = androidx.compose.foundation.BorderStroke(1.dp, SleekBorder)\n            ) {\n                Column(\n                    modifier = Modifier.padding(14.dp),\n                    verticalArrangement = Arrangement.spacedBy(10.dp)\n                ) {\n                    Text(\n                        text = \"Global Background Policies\",\n                        style = MaterialTheme.typography.titleSmall.copy(fontWeight = FontWeight.Bold),\n                        color = MaterialTheme.colorScheme.onSurface\n                    )\n                    Text(\n                        text = \"Quickly apply background and idle rules to all non-system applications:\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = SleekMutedText\n                    )\n\n                    Row(\n                        modifier = Modifier.fillMaxWidth(),\n                        horizontalArrangement = Arrangement.spacedBy(8.dp)\n                    ) {\n                        FilledTonalButton(\n                            onClick = { onSetBlockAllBackground(true) },\n                            modifier = Modifier.weight(1f),\n                            shape = RoundedCornerShape(10.dp),\n                            contentPadding = PaddingValues(horizontal = 4.dp, vertical = 6.dp),\n                            colors = ButtonDefaults.filledTonalButtonColors(\n                                containerColor = SleekBlockedContainer,\n                                contentColor = SleekBlockedRed\n                            )\n                        ) {\n                            Text(\"Background\", fontSize = 11.sp, fontWeight = FontWeight.Bold, maxLines = 1)\n                        }\n\n                        FilledTonalButton(\n                            onClick = { onSetBlockAllScreenOff(true) },\n                            modifier = Modifier.weight(1f),\n                            shape = RoundedCornerShape(10.dp),\n                            contentPadding = PaddingValues(horizontal = 4.dp, vertical = 6.dp),\n                            colors = ButtonDefaults.filledTonalButtonColors(\n                                containerColor = StatusWarningAmber.copy(alpha = 0.15f),\n                                contentColor = StatusWarningAmber\n                            )\n                        ) {\n                            Text(\"Screen-Off\", fontSize = 11.sp, fontWeight = FontWeight.Bold, maxLines = 1)\n                        }\n\n                        FilledTonalButton(\n                            onClick = { onSetBlockAllDeviceIdle(true) },\n                            modifier = Modifier.weight(1f),\n                            shape = RoundedCornerShape(10.dp),\n                            contentPadding = PaddingValues(horizontal = 4.dp, vertical = 6.dp),\n                            colors = ButtonDefaults.filledTonalButtonColors(\n                                containerColor = SleekPrimaryContainer,\n                                contentColor = SleekPrimary\n                            )\n                        ) {\n                            Text(\"Idle / Doze\", fontSize = 11.sp, fontWeight = FontWeight.Bold, maxLines = 1)\n                        }\n                    }\n\n                    Row(\n                        modifier = Modifier.fillMaxWidth(),\n                        horizontalArrangement = Arrangement.End\n                    ) {\n                        androidx.compose.material3.TextButton(\n                            onClick = { onSetBlockAllBackground(false) }\n                        ) {\n                            Text(\"Allow Background for All\", fontSize = 11.sp, color = SleekPrimary)\n                        }\n                    }\n                }\n            }\n        }\n\n        // 4. Section Header\n        item {\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                horizontalArrangement = Arrangement.SpaceBetween,\n                verticalAlignment = Alignment.CenterVertically\n            ) {\n                Text(\n                    text = \"PER-APP BACKGROUND CONTROLS\",\n                    style = MaterialTheme.typography.labelSmall.copy(\n                        fontWeight = FontWeight.Bold,\n                        letterSpacing = 0.8.sp\n                    ),\n                    color = SleekMutedText\n                )\n                Text(\n                    text = \"${apps.size} apps\",\n                    style = MaterialTheme.typography.bodySmall,\n                    color = SleekMutedText\n                )\n            }\n        }\n\n        // 5. Per-App Background Items\n        items(apps, key = { \"bg_${it.packageName}\" }) { appItem ->\n            AppBackgroundItemCard(\n                app = appItem,\n                onToggleBackground = { onToggleBackground(appItem) },\n                onToggleScreenOff = { onToggleScreenOff(appItem) },\n                onToggleDeviceIdle = { onToggleDeviceIdle(appItem) },\n                onClick = { onAppClick(appItem) }\n            )\n        }\n    }\n}\n\n@Composable\nfun AppBackgroundItemCard(\n    app: AppItem,\n    onToggleBackground: () -> Unit,\n    onToggleScreenOff: () -> Unit,\n    onToggleDeviceIdle: () -> Unit,\n    onClick: () -> Unit,\n    modifier: Modifier = Modifier\n) {\n    val rule = app.rule\n    val isBgBlocked = rule.blockBackground || rule.isBlocked\n\n    Card(\n        modifier = modifier\n            .fillMaxWidth()\n            .clickable(onClick = onClick)\n            .testTag(\"app_bg_card_${app.packageName}\"),\n        shape = RoundedCornerShape(16.dp),\n        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),\n        border = androidx.compose.foundation.BorderStroke(1.dp, SleekBorder)\n    ) {\n        Column(\n            modifier = Modifier.padding(14.dp),\n            verticalArrangement = Arrangement.spacedBy(10.dp)\n        ) {\n            // App Header\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                verticalAlignment = Alignment.CenterVertically,\n                horizontalArrangement = Arrangement.spacedBy(12.dp)\n            ) {\n                // App Icon\n                if (app.iconBitmap != null) {\n                    Image(\n                        bitmap = app.iconBitmap.asImageBitmap(),\n                        contentDescription = \"${app.appName} icon\",\n                        modifier = Modifier\n                            .size(42.dp)\n                            .clip(RoundedCornerShape(10.dp))\n                    )\n                } else {\n                    Box(\n                        modifier = Modifier\n                            .size(42.dp)\n                            .clip(RoundedCornerShape(10.dp))\n                            .background(SleekSurfaceVariant),\n                        contentAlignment = Alignment.Center\n                    ) {\n                        Text(\n                            text = app.appName.take(1).uppercase(),\n                            style = MaterialTheme.typography.titleMedium.copy(fontWeight = FontWeight.Bold),\n                            color = SleekPrimary\n                        )\n                    }\n                }\n\n                Column(modifier = Modifier.weight(1f)) {\n                    Row(\n                        verticalAlignment = Alignment.CenterVertically,\n                        horizontalArrangement = Arrangement.spacedBy(6.dp)\n                    ) {\n                        Text(\n                            text = app.appName,\n                            style = MaterialTheme.typography.titleSmall.copy(fontWeight = FontWeight.SemiBold),\n                            color = MaterialTheme.colorScheme.onSurface,\n                            maxLines = 1\n                        )\n                        if (app.isSystemApp) {\n                            Surface(\n                                shape = RoundedCornerShape(4.dp),\n                                color = SleekSurfaceVariant\n                            ) {\n                                Text(\n                                    text = \"SYSTEM\",\n                                    style = MaterialTheme.typography.labelSmall.copy(fontSize = 9.sp),\n                                    color = SleekMutedText,\n                                    modifier = Modifier.padding(horizontal = 4.dp, vertical = 1.dp)\n                                )\n                            }\n                        }\n                    }\n                    Text(\n                        text = \"UID ${app.uid} \342\200\242 ${app.packageName}\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = SleekMutedText,\n                        maxLines = 1,\n                        fontSize = 11.sp\n                    )\n                }\n\n                // Status Pill\n                Surface(\n                    shape = RoundedCornerShape(8.dp),\n                    color = if (isBgBlocked) SleekBlockedContainer else SleekAllowedContainer\n                ) {\n                    Text(\n                        text = if (isBgBlocked) \"BG BLOCKED\" else \"BG ALLOWED\",\n                        style = MaterialTheme.typography.labelSmall.copy(fontWeight = FontWeight.Bold),\n                        color = if (isBgBlocked) SleekBlockedRed else SleekPrimary,\n                        fontSize = 9.sp,\n                        modifier = Modifier.padding(horizontal = 6.dp, vertical = 3.dp)\n                    )\n                }\n            }\n\n            androidx.compose.material3.HorizontalDivider(color = SleekBorder.copy(alpha = 0.5f))\n\n            // Granular Background Controls Row 1: Allow/Block Background Network\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                horizontalArrangement = Arrangement.SpaceBetween,\n                verticalAlignment = Alignment.CenterVertically\n            ) {\n                Row(\n                    horizontalArrangement = Arrangement.spacedBy(8.dp),\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Icon(\n                        imageVector = if (rule.blockBackground) Icons.Default.SyncDisabled else Icons.Default.Sync,\n                        contentDescription = null,\n                        tint = if (rule.blockBackground) SleekBlockedRed else SleekPrimary,\n                        modifier = Modifier.size(18.dp)\n                    )\n                    Column {\n                        Text(\n                            text = if (rule.blockBackground) \"Block Background Network\" else \"Allow Background Network\",\n                            style = MaterialTheme.typography.bodyMedium.copy(fontWeight = FontWeight.Medium),\n                            color = MaterialTheme.colorScheme.onSurface\n                        )\n                        Text(\n                            text = if (rule.blockBackground) \"Background sockets dropped\" else \"Permits background syncing\",\n                            style = MaterialTheme.typography.bodySmall,\n                            color = SleekMutedText,\n                            fontSize = 11.sp\n                        )\n                    }\n                }\n\n                Switch(\n                    checked = !rule.blockBackground && !rule.isBlocked,\n                    onCheckedChange = { onToggleBackground() },\n                    colors = SwitchDefaults.colors(\n                        checkedThumbColor = SleekPrimary,\n                        checkedTrackColor = SleekPrimaryContainer\n                    )\n                )\n            }\n\n            // Granular Background Controls Row 2: Block when Screen is OFF\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                horizontalArrangement = Arrangement.SpaceBetween,\n                verticalAlignment = Alignment.CenterVertically\n            ) {\n                Row(\n                    horizontalArrangement = Arrangement.spacedBy(8.dp),\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Icon(\n                        imageVector = Icons.Default.ScreenLockPortrait,\n                        contentDescription = null,\n                        tint = if (rule.blockScreenOff) StatusWarningAmber else SleekMutedText,\n                        modifier = Modifier.size(18.dp)\n                    )\n                    Column {\n                        Text(\n                            text = \"Block when Screen is OFF\",\n                            style = MaterialTheme.typography.bodyMedium.copy(fontWeight = FontWeight.Medium),\n                            color = MaterialTheme.colorScheme.onSurface\n                        )\n                        Text(\n                            text = if (rule.blockScreenOff) \"Sockets cut when display sleeps\" else \"Screen state ignored\",\n                            style = MaterialTheme.typography.bodySmall,\n                            color = SleekMutedText,\n                            fontSize = 11.sp\n                        )\n                    }\n                }\n\n                Switch(\n                    checked = rule.blockScreenOff,\n                    onCheckedChange = { onToggleScreenOff() },\n                    colors = SwitchDefaults.colors(\n                        checkedThumbColor = StatusWarningAmber,\n                        checkedTrackColor = StatusWarningAmber.copy(alpha = 0.2f)\n                    )\n                )\n            }\n\n            // Granular Background Controls Row 3: Block when Device is Idle\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                horizontalArrangement = Arrangement.SpaceBetween,\n                verticalAlignment = Alignment.CenterVertically\n            ) {\n                Row(\n                    horizontalArrangement = Arrangement.spacedBy(8.dp),\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Icon(\n                        imageVector = Icons.Default.HourglassEmpty,\n                        contentDescription = null,\n                        tint = if (rule.blockDeviceIdle) SleekPrimary else SleekMutedText,\n                        modifier = Modifier.size(18.dp)\n                    )\n                    Column {\n                        Text(\n                            text = \"Block when Device is Idle\",\n                            style = MaterialTheme.typography.bodyMedium.copy(fontWeight = FontWeight.Medium),\n                            color = MaterialTheme.colorScheme.onSurface\n                        )\n                        Text(\n                            text = if (rule.blockDeviceIdle) \"Traffic dropped during system Doze\" else \"Idle state ignored\",\n                            style = MaterialTheme.typography.bodySmall,\n                            color = SleekMutedText,\n                            fontSize = 11.sp\n                        )\n                    }\n                }\n\n                Switch(\n                    checked = rule.blockDeviceIdle,\n                    onCheckedChange = { onToggleDeviceIdle() },\n                    colors = SwitchDefaults.colors(\n                        checkedThumbColor = SleekPrimary,\n                        checkedTrackColor = SleekPrimaryContainer\n                    )\n                )\n            }\n        }\n    }\n}\n\n@Composable\nfun AndroidLimitationsExplanationCard(modifier: Modifier = Modifier) {\n    var expanded by remember { mutableStateOf(false) }\n\n    Card(\n        modifier = modifier\n            .fillMaxWidth()\n            .clickable { expanded = !expanded },\n        shape = RoundedCornerShape(16.dp),\n        colors = CardDefaults.cardColors(containerColor = SleekSurfaceVariant),\n        border = androidx.compose.foundation.BorderStroke(1.dp, SleekBorder.copy(alpha = 0.6f))\n    ) {\n        Column(\n            modifier = Modifier.padding(16.dp),\n            verticalArrangement = Arrangement.spacedBy(10.dp)\n        ) {\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                horizontalArrangement = Arrangement.SpaceBetween,\n                verticalAlignment = Alignment.CenterVertically\n            ) {\n                Row(\n                    horizontalArrangement = Arrangement.spacedBy(8.dp),\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Icon(\n                        imageVector = Icons.Default.Info,\n                        contentDescription = null,\n                        tint = SleekPrimary,\n                        modifier = Modifier.size(20.dp)\n                    )\n                    Text(\n                        text = \"Android OS & OEM Background Limits\",\n                        style = MaterialTheme.typography.titleSmall.copy(fontWeight = FontWeight.Bold),\n                        color = MaterialTheme.colorScheme.onSurface\n                    )\n                }\n\n                Icon(\n                    imageVector = if (expanded) Icons.Default.ExpandLess else Icons.Default.ExpandMore,\n                    contentDescription = if (expanded) \"Collapse\" else \"Expand\",\n                    tint = SleekMutedText\n                )\n            }\n\n            Text(\n                text = \"Understanding how background network restrictions operate on non-root Android across OS versions and device manufacturers.\",\n                style = MaterialTheme.typography.bodySmall,\n                color = SleekMutedText\n            )\n\n            if (expanded) {\n                androidx.compose.material3.HorizontalDivider(color = SleekBorder.copy(alpha = 0.5f))\n\n                // 1. Android Sandbox & NetGuardian VpnService Architecture\n                Text(\n                    text = \"1. Non-Root Sandbox vs. Network Layer Filtering\",\n                    style = MaterialTheme.typography.labelMedium.copy(fontWeight = FontWeight.Bold),\n                    color = SleekPrimary\n                )\n                Text(\n                    text = \"Android\'s security architecture strictly prohibits third-party applications from forcibly killing, suspending, or freezing external processes without root permissions. NetGuardian solves this by operating at the Linux kernel networking layer using Android VpnService: rather than killing the app process, NetGuardian instantly drops or sinkholes all TCP/UDP socket connections from that application\'s UID as soon as background, screen-off, or device-idle conditions are satisfied.\",\n                    style = MaterialTheme.typography.bodySmall,\n                    color = SleekBodyText\n                )\n\n                // 2. Android Version Boundaries\n                Text(\n                    text = \"2. Android OS Version Restrictions\",\n                    style = MaterialTheme.typography.labelMedium.copy(fontWeight = FontWeight.Bold),\n                    color = SleekPrimary\n                )\n                Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {\n                    Text(\n                        text = \"\342\200\242 Android 7.0\342\200\2238.0 (Nougat/Oreo): Introduced system Data Saver and Background Execution Limits. Apps without foreground services cannot hold long-lived background threads.\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = SleekBodyText\n                    )\n                    Text(\n                        text = \"\342\200\242 Android 9.0\342\200\22311 (Pie/Q/R): Introduced App Standby Buckets (Active, Working Set, Frequent, Rare). Network sync frequency is throttled by Android when an app moves to Rare or Restricted.\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = SleekBodyText\n                    )\n                    Text(\n                        text = \"\342\200\242 Android 12\342\200\22314+ (Snow Cone/Tiramisu/UpsideDownCake): Enforces the Phantom Process Killer (maximum 32 child processes system-wide) and strict foreground service type mandates (FOREGROUND_SERVICE_DATA_SYNC).\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = SleekBodyText\n                    )\n                }\n\n                // 3. Manufacturer OEM Aggressive Killers\n                Text(\n                    text = \"3. OEM Manufacturer Battery Killers\",\n                    style = MaterialTheme.typography.labelMedium.copy(fontWeight = FontWeight.Bold),\n                    color = SleekPrimary\n                )\n                Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {\n                    Text(\n                        text = \"\342\200\242 Samsung (OneUI): \'Sleeping apps\' & \'Deep sleeping apps\' suspend execution. NetGuardian must be added to \'Never auto-sleeping apps\' in Device Care to prevent VPN teardown.\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = SleekBodyText\n                    )\n                    Text(\n                        text = \"\342\200\242 Xiaomi (MIUI / HyperOS): Proprietary battery saver terminates background sockets after 10 minutes of display timeout unless \'No restrictions\' is selected.\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = SleekBodyText\n                    )\n                    Text(\n                        text = \"\342\200\242 Huawei / Honor (EMUI / MagicOS): \'PowerGenie\' aggressively cleans background tasks ignoring standard Android JobSchedulers.\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = SleekBodyText\n                    )\n                    Text(\n                        text = \"\342\200\242 OnePlus / Oppo (OxygenOS / ColorOS): \'Deep Optimization\' resets background socket listeners when the device is idle.\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = SleekBodyText\n                    )\n                }\n            }\n        }\n    }\n}\n\n@Composable\nfun DetailSwitchRow(\n    title: String,\n    subtitle: String,\n    checked: Boolean,\n    onCheckedChange: (Boolean) -> Unit,\n    modifier: Modifier = Modifier\n) {\n    Row(\n        modifier = modifier.fillMaxWidth(),\n        horizontalArrangement = Arrangement.SpaceBetween,\n        verticalAlignment = Alignment.CenterVertically\n    ) {\n        Column(modifier = Modifier.weight(1f)) {\n            Text(\n                text = title,\n                style = MaterialTheme.typography.titleSmall.copy(fontWeight = FontWeight.SemiBold),\n                color = SleekBodyText\n            )\n            Text(\n                text = subtitle,\n                style = MaterialTheme.typography.bodySmall,\n                color = SleekMutedText\n            )\n        }\n        Switch(\n            checked = checked,\n            onCheckedChange = onCheckedChange,\n            colors = SwitchDefaults.colors(\n                checkedThumbColor = SleekPrimary,\n                checkedTrackColor = SleekPrimaryContainer\n            )\n        )\n    }\n}"
        replacement_content: "        // 1. Search Bar\n        item {\n            OutlinedTextField(\n                value = searchQuery,\n                onValueChange = onSearchChange,\n                placeholder = { Text(\"Search apps for background rules...\", color = MaterialTheme.colorScheme.onSurfaceVariant) },\n                leadingIcon = { Icon(Icons.Default.Search, contentDescription = \"Search\", tint = MaterialTheme.colorScheme.onSurfaceVariant) },\n                trailingIcon = {\n                    if (searchQuery.isNotEmpty()) {\n                        IconButton(onClick = { onSearchChange(\"\") }) {\n                            Icon(Icons.Default.Clear, contentDescription = \"Clear\", tint = MaterialTheme.colorScheme.onSurfaceVariant)\n                        }\n                    }\n                },\n                singleLine = true,\n                shape = RoundedCornerShape(16.dp),\n                colors = OutlinedTextFieldDefaults.colors(\n                    focusedBorderColor = MaterialTheme.colorScheme.primary,\n                    unfocusedBorderColor = MaterialTheme.colorScheme.outlineVariant,\n                    focusedContainerColor = MaterialTheme.colorScheme.surface,\n                    unfocusedContainerColor = MaterialTheme.colorScheme.surface\n                ),\n                modifier = Modifier.fillMaxWidth()\n            )\n        }\n\n        // 2. Android & OEM Limitations Deep Dive Card\n        item {\n            AndroidLimitationsExplanationCard()\n        }\n\n        // 3. Global Quick Actions for Background Policies\n        item {\n            val netGuardian = MaterialTheme.netGuardian\n            Card(\n                modifier = Modifier.fillMaxWidth(),\n                shape = RoundedCornerShape(16.dp),\n                colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),\n                border = androidx.compose.foundation.BorderStroke(1.dp, MaterialTheme.colorScheme.outlineVariant)\n            ) {\n                Column(\n                    modifier = Modifier.padding(14.dp),\n                    verticalArrangement = Arrangement.spacedBy(10.dp)\n                ) {\n                    Text(\n                        text = \"Global Background Policies\",\n                        style = MaterialTheme.typography.titleSmall.copy(fontWeight = FontWeight.Bold),\n                        color = MaterialTheme.colorScheme.onSurface\n                    )\n                    Text(\n                        text = \"Quickly apply background and idle rules to all non-system applications:\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant\n                    )\n\n                    Row(\n                        modifier = Modifier.fillMaxWidth(),\n                        horizontalArrangement = Arrangement.spacedBy(8.dp)\n                    ) {\n                        FilledTonalButton(\n                            onClick = { onSetBlockAllBackground(true) },\n                            modifier = Modifier.weight(1f),\n                            shape = RoundedCornerShape(10.dp),\n                            contentPadding = PaddingValues(horizontal = 4.dp, vertical = 6.dp),\n                            colors = ButtonDefaults.filledTonalButtonColors(\n                                containerColor = netGuardian.blockedContainer,\n                                contentColor = netGuardian.blocked\n                            )\n                        ) {\n                            Text(\"Background\", fontSize = 11.sp, fontWeight = FontWeight.Bold, maxLines = 1)\n                        }\n\n                        FilledTonalButton(\n                            onClick = { onSetBlockAllScreenOff(true) },\n                            modifier = Modifier.weight(1f),\n                            shape = RoundedCornerShape(10.dp),\n                            contentPadding = PaddingValues(horizontal = 4.dp, vertical = 6.dp),\n                            colors = ButtonDefaults.filledTonalButtonColors(\n                                containerColor = netGuardian.warningContainer,\n                                contentColor = netGuardian.warning\n                            )\n                        ) {\n                            Text(\"Screen-Off\", fontSize = 11.sp, fontWeight = FontWeight.Bold, maxLines = 1)\n                        }\n\n                        FilledTonalButton(\n                            onClick = { onSetBlockAllDeviceIdle(true) },\n                            modifier = Modifier.weight(1f),\n                            shape = RoundedCornerShape(10.dp),\n                            contentPadding = PaddingValues(horizontal = 4.dp, vertical = 6.dp),\n                            colors = ButtonDefaults.filledTonalButtonColors(\n                                containerColor = MaterialTheme.colorScheme.primaryContainer,\n                                contentColor = MaterialTheme.colorScheme.onPrimaryContainer\n                            )\n                        ) {\n                            Text(\"Idle / Doze\", fontSize = 11.sp, fontWeight = FontWeight.Bold, maxLines = 1)\n                        }\n                    }\n\n                    Row(\n                        modifier = Modifier.fillMaxWidth(),\n                        horizontalArrangement = Arrangement.End\n                    ) {\n                        androidx.compose.material3.TextButton(\n                            onClick = { onSetBlockAllBackground(false) }\n                        ) {\n                            Text(\"Allow Background for All\", fontSize = 11.sp, color = MaterialTheme.colorScheme.primary)\n                        }\n                    }\n                }\n            }\n        }\n\n        // 4. Section Header\n        item {\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                horizontalArrangement = Arrangement.SpaceBetween,\n                verticalAlignment = Alignment.CenterVertically\n            ) {\n                Text(\n                    text = \"PER-APP BACKGROUND CONTROLS\",\n                    style = MaterialTheme.typography.labelSmall.copy(\n                        fontWeight = FontWeight.Bold,\n                        letterSpacing = 0.8.sp\n                    ),\n                    color = MaterialTheme.colorScheme.onSurfaceVariant\n                )\n                Text(\n                    text = \"${apps.size} apps\",\n                    style = MaterialTheme.typography.bodySmall,\n                    color = MaterialTheme.colorScheme.onSurfaceVariant\n                )\n            }\n        }\n\n        // 5. Per-App Background Items\n        items(apps, key = { \"bg_${it.packageName}\" }) { appItem ->\n            AppBackgroundItemCard(\n                app = appItem,\n                onToggleBackground = { onToggleBackground(appItem) },\n                onToggleScreenOff = { onToggleScreenOff(appItem) },\n                onToggleDeviceIdle = { onToggleDeviceIdle(appItem) },\n                onClick = { onAppClick(appItem) }\n            )\n        }\n    }\n}\n\n@Composable\nfun AppBackgroundItemCard(\n    app: AppItem,\n    onToggleBackground: () -> Unit,\n    onToggleScreenOff: () -> Unit,\n    onToggleDeviceIdle: () -> Unit,\n    onClick: () -> Unit,\n    modifier: Modifier = Modifier\n) {\n    val rule = app.rule\n    val isBgBlocked = rule.blockBackground || rule.isBlocked\n    val netGuardian = MaterialTheme.netGuardian\n\n    Card(\n        modifier = modifier\n            .fillMaxWidth()\n            .clickable(onClick = onClick)\n            .testTag(\"app_bg_card_${app.packageName}\"),\n        shape = RoundedCornerShape(16.dp),\n        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),\n        border = androidx.compose.foundation.BorderStroke(1.dp, MaterialTheme.colorScheme.outlineVariant)\n    ) {\n        Column(\n            modifier = Modifier.padding(14.dp),\n            verticalArrangement = Arrangement.spacedBy(10.dp)\n        ) {\n            // App Header\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                verticalAlignment = Alignment.CenterVertically,\n                horizontalArrangement = Arrangement.spacedBy(12.dp)\n            ) {\n                // App Icon\n                if (app.iconBitmap != null) {\n                    Image(\n                        bitmap = app.iconBitmap.asImageBitmap(),\n                        contentDescription = \"${app.appName} icon\",\n                        modifier = Modifier\n                            .size(42.dp)\n                            .clip(RoundedCornerShape(10.dp))\n                    )\n                } else {\n                    Box(\n                        modifier = Modifier\n                            .size(42.dp)\n                            .clip(RoundedCornerShape(10.dp))\n                            .background(MaterialTheme.colorScheme.surfaceVariant),\n                        contentAlignment = Alignment.Center\n                    ) {\n                        Text(\n                            text = app.appName.take(1).uppercase(),\n                            style = MaterialTheme.typography.titleMedium.copy(fontWeight = FontWeight.Bold),\n                            color = MaterialTheme.colorScheme.primary\n                        )\n                    }\n                }\n\n                Column(modifier = Modifier.weight(1f)) {\n                    Row(\n                        verticalAlignment = Alignment.CenterVertically,\n                        horizontalArrangement = Arrangement.spacedBy(6.dp)\n                    ) {\n                        Text(\n                            text = app.appName,\n                            style = MaterialTheme.typography.titleSmall.copy(fontWeight = FontWeight.SemiBold),\n                            color = MaterialTheme.colorScheme.onSurface,\n                            maxLines = 1\n                        )\n                        if (app.isSystemApp) {\n                            Surface(\n                                shape = RoundedCornerShape(4.dp),\n                                color = MaterialTheme.colorScheme.surfaceVariant\n                            ) {\n                                Text(\n                                    text = \"SYSTEM\",\n                                    style = MaterialTheme.typography.labelSmall.copy(fontSize = 9.sp),\n                                    color = MaterialTheme.colorScheme.onSurfaceVariant,\n                                    modifier = Modifier.padding(horizontal = 4.dp, vertical = 1.dp)\n                                )\n                            }\n                        }\n                    }\n                    Text(\n                        text = \"UID ${app.uid} \342\200\242 ${app.packageName}\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant,\n                        maxLines = 1,\n                        fontSize = 11.sp\n                    )\n                }\n\n                // Status Pill\n                Surface(\n                    shape = RoundedCornerShape(8.dp),\n                    color = if (isBgBlocked) netGuardian.blockedContainer else netGuardian.allowedContainer\n                ) {\n                    Text(\n                        text = if (isBgBlocked) \"BG BLOCKED\" else \"BG ALLOWED\",\n                        style = MaterialTheme.typography.labelSmall.copy(fontWeight = FontWeight.Bold),\n                        color = if (isBgBlocked) netGuardian.onBlockedContainer else netGuardian.onAllowedContainer,\n                        fontSize = 9.sp,\n                        modifier = Modifier.padding(horizontal = 6.dp, vertical = 3.dp)\n                    )\n                }\n            }\n\n            androidx.compose.material3.HorizontalDivider(color = MaterialTheme.colorScheme.outlineVariant.copy(alpha = 0.5f))\n\n            // Granular Background Controls Row 1: Allow/Block Background Network\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                horizontalArrangement = Arrangement.SpaceBetween,\n                verticalAlignment = Alignment.CenterVertically\n            ) {\n                Row(\n                    horizontalArrangement = Arrangement.spacedBy(8.dp),\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Icon(\n                        imageVector = if (rule.blockBackground) Icons.Default.SyncDisabled else Icons.Default.Sync,\n                        contentDescription = null,\n                        tint = if (rule.blockBackground) netGuardian.blocked else MaterialTheme.colorScheme.primary,\n                        modifier = Modifier.size(18.dp)\n                    )\n                    Column {\n                        Text(\n                            text = if (rule.blockBackground) \"Block Background Network\" else \"Allow Background Network\",\n                            style = MaterialTheme.typography.bodyMedium.copy(fontWeight = FontWeight.Medium),\n                            color = MaterialTheme.colorScheme.onSurface\n                        )\n                        Text(\n                            text = if (rule.blockBackground) \"Background sockets dropped\" else \"Permits background syncing\",\n                            style = MaterialTheme.typography.bodySmall,\n                            color = MaterialTheme.colorScheme.onSurfaceVariant,\n                            fontSize = 11.sp\n                        )\n                    }\n                }\n\n                Switch(\n                    checked = !rule.blockBackground && !rule.isBlocked,\n                    onCheckedChange = { onToggleBackground() },\n                    colors = SwitchDefaults.colors(\n                        checkedThumbColor = MaterialTheme.colorScheme.primary,\n                        checkedTrackColor = MaterialTheme.colorScheme.primaryContainer,\n                        uncheckedThumbColor = MaterialTheme.colorScheme.outline,\n                        uncheckedTrackColor = MaterialTheme.colorScheme.surfaceVariant\n                    )\n                )\n            }\n\n            // Granular Background Controls Row 2: Block when Screen is OFF\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                horizontalArrangement = Arrangement.SpaceBetween,\n                verticalAlignment = Alignment.CenterVertically\n            ) {\n                Row(\n                    horizontalArrangement = Arrangement.spacedBy(8.dp),\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Icon(\n                        imageVector = Icons.Default.ScreenLockPortrait,\n                        contentDescription = null,\n                        tint = if (rule.blockScreenOff) netGuardian.warning else MaterialTheme.colorScheme.onSurfaceVariant,\n                        modifier = Modifier.size(18.dp)\n                    )\n                    Column {\n                        Text(\n                            text = \"Block when Screen is OFF\",\n                            style = MaterialTheme.typography.bodyMedium.copy(fontWeight = FontWeight.Medium),\n                            color = MaterialTheme.colorScheme.onSurface\n                        )\n                        Text(\n                            text = if (rule.blockScreenOff) \"Sockets cut when display sleeps\" else \"Screen state ignored\",\n                            style = MaterialTheme.typography.bodySmall,\n                            color = MaterialTheme.colorScheme.onSurfaceVariant,\n                            fontSize = 11.sp\n                        )\n                    }\n                }\n\n                Switch(\n                    checked = rule.blockScreenOff,\n                    onCheckedChange = { onToggleScreenOff() },\n                    colors = SwitchDefaults.colors(\n                        checkedThumbColor = netGuardian.warning,\n                        checkedTrackColor = netGuardian.warningContainer,\n                        uncheckedThumbColor = MaterialTheme.colorScheme.outline,\n                        uncheckedTrackColor = MaterialTheme.colorScheme.surfaceVariant\n                    )\n                )\n            }\n\n            // Granular Background Controls Row 3: Block when Device is Idle\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                horizontalArrangement = Arrangement.SpaceBetween,\n                verticalAlignment = Alignment.CenterVertically\n            ) {\n                Row(\n                    horizontalArrangement = Arrangement.spacedBy(8.dp),\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Icon(\n                        imageVector = Icons.Default.HourglassEmpty,\n                        contentDescription = null,\n                        tint = if (rule.blockDeviceIdle) MaterialTheme.colorScheme.primary else MaterialTheme.colorScheme.onSurfaceVariant,\n                        modifier = Modifier.size(18.dp)\n                    )\n                    Column {\n                        Text(\n                            text = \"Block when Device is Idle\",\n                            style = MaterialTheme.typography.bodyMedium.copy(fontWeight = FontWeight.Medium),\n                            color = MaterialTheme.colorScheme.onSurface\n                        )\n                        Text(\n                            text = if (rule.blockDeviceIdle) \"Traffic dropped during system Doze\" else \"Idle state ignored\",\n                            style = MaterialTheme.typography.bodySmall,\n                            color = MaterialTheme.colorScheme.onSurfaceVariant,\n                            fontSize = 11.sp\n                        )\n                    }\n                }\n\n                Switch(\n                    checked = rule.blockDeviceIdle,\n                    onCheckedChange = { onToggleDeviceIdle() },\n                    colors = SwitchDefaults.colors(\n                        checkedThumbColor = MaterialTheme.colorScheme.primary,\n                        checkedTrackColor = MaterialTheme.colorScheme.primaryContainer,\n                        uncheckedThumbColor = MaterialTheme.colorScheme.outline,\n                        uncheckedTrackColor = MaterialTheme.colorScheme.surfaceVariant\n                    )\n                )\n            }\n        }\n    }\n}\n\n@Composable\nfun AndroidLimitationsExplanationCard(modifier: Modifier = Modifier) {\n    var expanded by remember { mutableStateOf(false) }\n\n    Card(\n        modifier = modifier\n            .fillMaxWidth()\n            .clickable { expanded = !expanded },\n        shape = RoundedCornerShape(16.dp),\n        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceVariant),\n        border = androidx.compose.foundation.BorderStroke(1.dp, MaterialTheme.colorScheme.outlineVariant)\n    ) {\n        Column(\n            modifier = Modifier.padding(16.dp),\n            verticalArrangement = Arrangement.spacedBy(10.dp)\n        ) {\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                horizontalArrangement = Arrangement.SpaceBetween,\n                verticalAlignment = Alignment.CenterVertically\n            ) {\n                Row(\n                    horizontalArrangement = Arrangement.spacedBy(8.dp),\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Icon(\n                        imageVector = Icons.Default.Info,\n                        contentDescription = null,\n                        tint = MaterialTheme.colorScheme.primary,\n                        modifier = Modifier.size(20.dp)\n                    )\n                    Text(\n                        text = \"Android OS & OEM Background Limits\",\n                        style = MaterialTheme.typography.titleSmall.copy(fontWeight = FontWeight.Bold),\n                        color = MaterialTheme.colorScheme.onSurface\n                    )\n                }\n\n                Icon(\n                    imageVector = if (expanded) Icons.Default.ExpandLess else Icons.Default.ExpandMore,\n                    contentDescription = if (expanded) \"Collapse\" else \"Expand\",\n                    tint = MaterialTheme.colorScheme.onSurfaceVariant\n                )\n            }\n\n            Text(\n                text = \"Understanding how background network restrictions operate on non-root Android across OS versions and device manufacturers.\",\n                style = MaterialTheme.typography.bodySmall,\n                color = MaterialTheme.colorScheme.onSurfaceVariant\n            )\n\n            if (expanded) {\n                androidx.compose.material3.HorizontalDivider(color = MaterialTheme.colorScheme.outlineVariant.copy(alpha = 0.5f))\n\n                // 1. Android Sandbox & NetGuardian VpnService Architecture\n                Text(\n                    text = \"1. Non-Root Sandbox vs. Network Layer Filtering\",\n                    style = MaterialTheme.typography.labelMedium.copy(fontWeight = FontWeight.Bold),\n                    color = MaterialTheme.colorScheme.primary\n                )\n                Text(\n                    text = \"Android\'s security architecture strictly prohibits third-party applications from forcibly killing, suspending, or freezing external processes without root permissions. NetGuardian solves this by operating at the Linux kernel networking layer using Android VpnService: rather than killing the app process, NetGuardian instantly drops or sinkholes all TCP/UDP socket connections from that application\'s UID as soon as background, screen-off, or device-idle conditions are satisfied.\",\n                    style = MaterialTheme.typography.bodySmall,\n                    color = MaterialTheme.colorScheme.onSurface\n                )\n\n                // 2. Android Version Boundaries\n                Text(\n                    text = \"2. Android OS Version Restrictions\",\n                    style = MaterialTheme.typography.labelMedium.copy(fontWeight = FontWeight.Bold),\n                    color = MaterialTheme.colorScheme.primary\n                )\n                Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {\n                    Text(\n                        text = \"\342\200\242 Android 7.0\342\200\2238.0 (Nougat/Oreo): Introduced system Data Saver and Background Execution Limits. Apps without foreground services cannot hold long-lived background threads.\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = MaterialTheme.colorScheme.onSurface\n                    )\n                    Text(\n                        text = \"\342\200\242 Android 9.0\342\200\22311 (Pie/Q/R): Introduced App Standby Buckets (Active, Working Set, Frequent, Rare). Network sync frequency is throttled by Android when an app moves to Rare or Restricted.\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = MaterialTheme.colorScheme.onSurface\n                    )\n                    Text(\n                        text = \"\342\200\242 Android 12\342\200\22314+ (Snow Cone/Tiramisu/UpsideDownCake): Enforces the Phantom Process Killer (maximum 32 child processes system-wide) and strict foreground service type mandates (FOREGROUND_SERVICE_DATA_SYNC).\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = MaterialTheme.colorScheme.onSurface\n                    )\n                }\n\n                // 3. Manufacturer OEM Aggressive Killers\n                Text(\n                    text = \"3. OEM Manufacturer Battery Killers\",\n                    style = MaterialTheme.typography.labelMedium.copy(fontWeight = FontWeight.Bold),\n                    color = MaterialTheme.colorScheme.primary\n                )\n                Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {\n                    Text(\n                        text = \"\342\200\242 Samsung (OneUI): \'Sleeping apps\' & \'Deep sleeping apps\' suspend execution. NetGuardian must be added to \'Never auto-sleeping apps\' in Device Care to prevent VPN teardown.\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = MaterialTheme.colorScheme.onSurface\n                    )\n                    Text(\n                        text = \"\342\200\242 Xiaomi (MIUI / HyperOS): Proprietary battery saver terminates background sockets after 10 minutes of display timeout unless \'No restrictions\' is selected.\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = MaterialTheme.colorScheme.onSurface\n                    )\n                    Text(\n                        text = \"\342\200\242 Huawei / Honor (EMUI / MagicOS): \'PowerGenie\' aggressively cleans background tasks ignoring standard Android JobSchedulers.\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = MaterialTheme.colorScheme.onSurface\n                    )\n                    Text(\n                        text = \"\342\200\242 OnePlus / Oppo (OxygenOS / ColorOS): \'Deep Optimization\' resets background socket listeners when the device is idle.\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = MaterialTheme.colorScheme.onSurface\n                    )\n                }\n            }\n        }\n    }\n}\n\n@Composable\nfun DetailSwitchRow(\n    title: String,\n    subtitle: String,\n    checked: Boolean,\n    onCheckedChange: (Boolean) -> Unit,\n    modifier: Modifier = Modifier\n) {\n    Row(\n        modifier = modifier.fillMaxWidth(),\n        horizontalArrangement = Arrangement.SpaceBetween,\n        verticalAlignment = Alignment.CenterVertically\n    ) {\n        Column(modifier = Modifier.weight(1f)) {\n            Text(\n                text = title,\n                style = MaterialTheme.typography.titleSmall.copy(fontWeight = FontWeight.SemiBold),\n                color = MaterialTheme.colorScheme.onSurface\n            )\n            Text(\n                text = subtitle,\n                style = MaterialTheme.typography.bodySmall,\n                color = MaterialTheme.colorScheme.onSurfaceVariant\n            )\n        }\n        Switch(\n            checked = checked,\n            onCheckedChange = onCheckedChange,\n            colors = SwitchDefaults.colors(\n                checkedThumbColor = MaterialTheme.colorScheme.primary,\n                checkedTrackColor = MaterialTheme.colorScheme.primaryContainer,\n                uncheckedThumbColor = MaterialTheme.colorScheme.outline,\n                uncheckedTrackColor = MaterialTheme.colorScheme.surfaceVariant\n            )\n        )\n    }\n}"
      }
      num_matches: 1
    }
  }
