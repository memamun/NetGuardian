      original_chunk {
        target_content: "    private fun updateTileState() {\n        val tile = qsTile ?: return\n        val isActive = firewallManager.isFirewallActive.value\n        tile.state = if (isActive) Tile.STATE_ACTIVE else Tile.STATE_INACTIVE\n        tile.label = if (isActive) \"Firewall: ON\" else \"Firewall: OFF\"\n        tile.updateTile()\n    }"
        replacement_content: "    private fun updateTileState() {\n        val tile = qsTile ?: return\n        val isActive = firewallManager.isFirewallActive.value\n        val mode = firewallManager.activeQuickMode.value\n        tile.state = if (isActive) Tile.STATE_ACTIVE else Tile.STATE_INACTIVE\n        tile.label = if (isActive) \"Firewall: ON\" else \"Firewall: OFF\"\n        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {\n            tile.subtitle = if (isActive) {\n                if (mode != com.example.data.QuickMode.NORMAL) mode.label else \"Protected\"\n            } else {\n                \"Tap to enable\"\n            }\n        }\n        tile.updateTile()\n    }"
      }
      num_matches: 1
    }
  }
