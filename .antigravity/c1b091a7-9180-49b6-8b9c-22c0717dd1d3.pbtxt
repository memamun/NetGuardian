          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Re-check permissions whenever app returns to foreground (resumes)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    DisposableEffect(lifecycleOwner) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val observer = LifecycleEventObserver { _, event ->"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            if (event == Lifecycle.Event.ON_RESUME) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                isVpnGranted = DiagnosticsHelper.isVpnAuthorized(context)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                isNotificationGranted = DiagnosticsHelper.isNotificationGranted(context)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                isBatteryOptimized = !DiagnosticsHelper.isBatteryOptimizationIgnored(context)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
