        }
        lines {
          text: "                text = \"Understanding how background network restrictions operate on non-root Android across OS versions and device manufacturers.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                style = MaterialTheme.typography.bodySmall,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
