    absolute_path_uri: "file:///app/src/main/java/com/example/ui/privacy/PrivacyScreen.kt"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "        // Technical Notice\n        item {\n            Card(\n                shape = RoundedCornerShape(14.dp),\n                colors = CardDefaults.cardColors(containerColor = SleekSurfaceVariant),\n                border = androidx.compose.foundation.BorderStroke(1.dp, SleekBorder.copy(alpha = 0.5f))\n            ) {\n                Row(\n                    modifier = Modifier.padding(14.dp),\n                    horizontalArrangement = Arrangement.spacedBy(12.dp),\n                    verticalAlignment = Alignment.Top\n                ) {\n                    Icon(\n                        imageVector = Icons.Default.Info,\n                        contentDescription = null,\n                        tint = SleekPrimary,\n                        modifier = Modifier.size(20.dp)\n                    )\n                    Text(\n                        text = \"NetGuardian inspects DNS packets on port 53 locally. Blocked domains are answered immediately with 0.0.0.0 (Sinkhole). No internet queries are forwarded to mandatory third-party tracking servers.\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = SleekMutedText\n                    )\n                }\n            }\n        }"
      replacement_content: "        // Upstream DNS Resolver (Local First, Zero Mandatory Third-Party Servers)\n        item {\n            Text(\n                text = \"UPSTREAM DNS RESOLVER\",\n                style = MaterialTheme.typography.labelMedium.copy(\n                    fontWeight = FontWeight.Bold,\n                    letterSpacing = 0.8.sp\n                ),\n                color = SleekBodyText\n            )\n        }\n\n        item {\n            Card(\n                modifier = Modifier\n                    .fillMaxWidth()\n                    .testTag(\"upstream_dns_card\"),\n                shape = RoundedCornerShape(16.dp),\n                colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),\n                border = androidx.compose.foundation.BorderStroke(1.dp, SleekBorder)\n            ) {\n                Column(\n                    modifier = Modifier.padding(16.dp),\n                    verticalArrangement = Arrangement.spacedBy(12.dp)\n                ) {\n                    Row(\n                        modifier = Modifier.fillMaxWidth(),\n                        horizontalArrangement = Arrangement.spacedBy(10.dp),\n                        verticalAlignment = Alignment.CenterVertically\n                    ) {\n                        Icon(\n                            imageVector = Icons.Default.Router,\n                            contentDescription = null,\n                            tint = SleekPrimary,\n                            modifier = Modifier.size(22.dp)\n                        )\n                        Column(modifier = Modifier.weight(1f)) {\n                            Text(\n                                text = \"Local & Private Upstream Routing\",\n                                style = MaterialTheme.typography.titleSmall.copy(fontWeight = FontWeight.Bold),\n                                color = SleekBodyText\n                            )\n                            Text(\n                                text = \"No third-party server is mandatory. You can use your local gateway, run offline, or configure a private Pi-hole.\",\n                                style = MaterialTheme.typography.bodySmall,\n                                color = SleekMutedText\n                            )\n                        }\n                    }\n\n                    Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {\n                        UpstreamDnsType.values().forEach { dnsOption ->\n                            val isSelected = prefs.upstreamDnsType == dnsOption\n                            Surface(\n                                modifier = Modifier\n                                    .fillMaxWidth(),\n                                shape = RoundedCornerShape(12.dp),\n                                color = if (isSelected) SleekPrimaryContainer.copy(alpha = 0.4f) else SleekSurfaceVariant.copy(alpha = 0.6f),\n                                border = androidx.compose.foundation.BorderStroke(\n                                    1.dp,\n                                    if (isSelected) SleekPrimary else Color.Transparent\n                                ),\n                                onClick = { viewModel.setUpstreamDnsType(dnsOption) }\n                            ) {\n                                Row(\n                                    modifier = Modifier\n                                        .fillMaxWidth()\n                                        .padding(12.dp),\n                                    verticalAlignment = Alignment.CenterVertically\n                                ) {\n                                    RadioButton(\n                                        selected = isSelected,\n                                        onClick = { viewModel.setUpstreamDnsType(dnsOption) },\n                                        colors = RadioButtonDefaults.colors(selectedColor = SleekPrimary)\n                                    )\n                                    Spacer(modifier = Modifier.size(8.dp))\n                                    Column(modifier = Modifier.weight(1f)) {\n                                        Text(\n                                            text = dnsOption.label,\n                                            style = MaterialTheme.typography.bodyMedium.copy(\n                                                fontWeight = if (isSelected) FontWeight.Bold else FontWeight.Normal\n                                            ),\n                                            color = SleekBodyText\n                                        )\n                                        Text(\n                                            text = dnsOption.description,\n                                            style = MaterialTheme.typography.bodySmall,\n                                            color = SleekMutedText,\n                                            fontSize = 11.sp\n                                        )\n                                    }\n                                }\n                            }\n                        }\n                    }\n\n                    if (prefs.upstreamDnsType == UpstreamDnsType.CUSTOM) {\n                        OutlinedTextField(\n                            value = prefs.customDnsIp,\n                            onValueChange = { viewModel.setCustomDnsIp(it) },\n                            label = { Text(\"Custom Resolver IPv4 Address\") },\n                            placeholder = { Text(\"e.g. 192.168.1.100\") },\n                            singleLine = true,\n                            shape = RoundedCornerShape(12.dp),\n                            modifier = Modifier\n                                .fillMaxWidth()\n                                .testTag(\"custom_dns_ip_field\"),\n                            colors = OutlinedTextFieldDefaults.colors(\n                                focusedBorderColor = SleekPrimary,\n                                unfocusedBorderColor = SleekBorder,\n                                focusedContainerColor = SleekSurfaceVariant,\n                                unfocusedContainerColor = SleekSurfaceVariant\n                            )\n                        )\n                    }\n                }\n            }\n        }\n\n        // Technical Notice\n        item {\n            Card(\n                shape = RoundedCornerShape(14.dp),\n                colors = CardDefaults.cardColors(containerColor = SleekSurfaceVariant),\n                border = androidx.compose.foundation.BorderStroke(1.dp, SleekBorder.copy(alpha = 0.5f))\n            ) {\n                Row(\n                    modifier = Modifier.padding(14.dp),\n                    horizontalArrangement = Arrangement.spacedBy(12.dp),\n                    verticalAlignment = Alignment.Top\n                ) {\n                    Icon(\n                        imageVector = Icons.Default.Info,\n                        contentDescription = null,\n                        tint = SleekPrimary,\n                        modifier = Modifier.size(20.dp)\n                    )\n                    Text(\n                        text = \"Local-First Architecture: NetGuardian intercepts UDP Port 53 queries right on your device. Blacklisted domains (ads, trackers, malware) are answered locally with a synthetic 0.0.0.0 sinkhole response. No queries are forwarded to mandatory external servers.\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = SleekMutedText\n                    )\n                }\n            }\n        }"
    }
